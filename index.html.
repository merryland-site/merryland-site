relative;filter:drop-shadow(0 12px 8px #a1d9ef22)}.bubble{position:absolute;border-radius:50%;background:var(--yellow);width:30px;height:30px;top:45px;right:35px}.bubble.two{background:#9ddcff;width:18px;height:18px;top:auto;bottom:50px;left:20px}section{padding:100px 0}.section-top{margin-bottom:36px}.kicker{color:#e4a246;font-size:12px;font-weight:900;letter-spacing:.18em;text-transform:uppercase}h2.section-title{font-size:clamp(31px,4.2vw,52px);letter-spacing:-.04em;margin:12px 0 15px}.lead{color:var(--muted);line-height:1.9;max-width:750px}.about{display:grid;grid-template-columns:.9fr 1.1fr;gap:70px;align-items:center}.about-card{min-height:330px;background:#e6f6ff;border-radius:40px;display:grid;place-items:center;position:relative;overflow:hidden}.about-card img{width:75%;opacity:.9}.year{position:absolute;bottom:30px;left:30px;background:#fff;border-radius:18px;padding:15px 22px;font-size:14px;font-weight:700}.year b{font-size:28px;color:#65bde8}.about p{line-height:1.95;color:var(--muted)}.tinted{background:#f6fbfe}.cards{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}.course{background:white;border:1px solid #e8f1f6;border-radius:24px;overflow:hidden;display:flex;flex-direction:column;box-shadow:0 10px 30px #3b85a908}.course-media{height:168px;background:linear-gradient(135deg,#e2f5ff,#fff5e6);display:grid;place-items:center;color:#72c8f4;font-size:46px;font-weight:800;overflow:hidden}.course-media img{width:100%;height:100%;object-fit:cover}.course-body{padding:22px;display:flex;flex:1;flex-direction:column}.course h3{margin:0 0 12px;font-size:18px}.course p{color:var(--muted);font-size:13px;line-height:1.7;flex:1}.price{font-weight:800;margin:12px 0 18px}.gallery{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.gallery-item{border-radius:24px;overflow:hidden;aspect-ratio:4/3;background:#e8f7ff;display:grid;place-items:center;position:relative}.gallery-item img{width:100%;height:100%;object-fit:cover}.gallery-item span{color:#72bddf;font-size:14px;font-weight:700;text-align:center;padding:20px}.gallery-item figcaption{position:absolute;bottom:0;left:0;right:0;padding:15px;color:white;background:linear-gradient(transparent,#1a3c56aa);font-size:13px}.schedule-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:22px}.schedule-card{background:white;border:1px solid #e0eef6;border-radius:30px;padding:27px;position:relative;overflow:hidden}.schedule-card:before{content:'m';position:absolute;right:4px;top:-50px;font-size:210px;font-weight:900;color:#eff9ff;z-index:0}.schedule-card>*{position:relative}.schedule-card h3{font-size:24px;margin:0 0 7px}.schedule-card .age{font-size:13px;color:#777;font-weight:700;margin-bottom:18px}.slot{display:flex;flex-wrap:wrap;gap:10px;align-items:center;padding:15px;background:#e9f7ff;border-radius:15px;margin:10px 0}.slot strong{font-size:18px}.slot small{color:#687784;flex:1;min-width:100px}.tag{font-size:11px;background:#fff;padding:7px 10px;border-radius:30px;font-weight:800;color:#4da8d5}.schedule-card .btn{margin-top:16px}.signup{background:linear-gradient(135deg,#cceeff,#e9f8ff);border-radius:40px;padding:65px;text-align:center}.signup p{line-height:1.8;color:#5b7280}.footer{padding:35px 0;background:#f6fbfe;font-size:13px;color:#70808b}.footer-inner{display:flex;justify-content:space-between;align-items:center;gap:20px}.edit-fab{position:fixed;bottom:22px;right:22px;z-index:30;background:#243e50;color:white;border:0;border-radius:40px;padding:14px 18px;font-size:13px;font-weight:800;box-shadow:0 7px 30px #0002}.overlay{position:fixed;inset:0;background:#132b3cb3;z-index:50;display:none;justify-content:flex-end}.overlay.open{display:flex}.panel{background:#fff;width:min(560px,100%);height:100%;overflow-y:auto;padding:26px;box-shadow:-12px 0 45px #0002}.panel-head{display:flex;align-items:center;justify-content:space-between;gap:15px}.panel h2{font-size:23px}.panel h3{margin-top:30px;border-bottom:1px solid #ddd;padding-bottom:9px}.panel label{display:block;font-size:12px;font-weight:800;margin:14px 0 6px}.panel input,.panel textarea,.panel select{width:100%;padding:12px;border:1px solid #cbdfe9;border-radius:12px;background:#fff;color:#293b4a}.panel textarea{min-height:76px;resize:vertical}.panel .item-editor{padding:15px;background:#f5fbff;border-radius:17px;margin:12px 0}.panel .item-editor h4{margin:0}.panel .muted{font-size:12px;line-height:1.6;color:#71808c}.panel .action-row{display:flex;flex-wrap:wrap;gap:8px;margin:14px 0}.panel .action-row button{border:0;border-radius:12px;padding:11px;background:#e4f4ff;font-weight:700}.panel .action-row button.danger{background:#ffe5e5}.close{border:0;background:#eef6fb;border-radius:12px;padding:9px 13px}.hint{background:#fff8e9;border-radius:12px;padding:12px;line-height:1.7;font-size:12px;color:#7e632d}#mobile-menu{display:none}@media(max-width:900px){.links{gap:12px;font-size:11px}.cards{grid-template-columns:repeat(2,1fr)}.hero-grid{min-height:520px}.about{gap:35px}}@media(max-width:650px){.nav{min-height:68px}.links{display:none;position:absolute;top:68px;left:0;right:0;background:white;padding:20px;flex-direction:column;align-items:stretch}.links.show{display:flex}#mobile-menu{display:block;border:0;background:#e6f6ff;padding:10px;border-radius:10px}.hero-grid{grid-template-columns:1fr;gap:0;padding-top:45px}.hero-art{height:250px}.hero-art img{width:66%}.hero-art:before{inset:10px 50px}.hero h1{font-size:63px}section{padding:65px 0}.about{grid-template-columns:1fr}.about-card{min-height:250px}.cards,.schedule-grid{grid-template-columns:1fr}.gallery{grid-template-columns:repeat(2,1fr);gap:10px}.signup{padding:35px 20px;border-radius:25px}.footer-inner{flex-direction:column;align-items:flex-start}.wrap{padding:0 20px}}
</style></head><body>
<header><div class="wrap nav"><a href="#home" class="brand"><img src="assets/mark.png" alt="Знак Merry land"><span>Merry land</span></a><button id="mobile-menu" aria-label="Відкрити меню">☰</button><nav class="links" id="links"><a href="#about">Про нас</a><a href="#courses">Напрямки</a><a href="#gallery">Галерея</a><a href="#places">Вільні місця</a><a class="btn small" href="#signup">Записатись</a></nav></div></header>
<main><div class="hero" id="home"><div class="wrap hero-grid"><div><div class="eyebrow">Англійська для дітей та дорослих</div><h1>Merry land</h1><h2>Школа твого розвитку</h2><p>Відкриваємо світ англійської з турботою про ваш комфорт. Навчаємо говорити впевнено — у Чернігові та онлайн з будь-якої точки світу.</p><a class="btn" href="#signup">Записатись на заняття ↗</a></div><div class="hero-art"><span class="bubble"></span><span class="bubble two"></span><img src="assets/logo.png" alt="Оригінальний логотип Merry land"></div></div></div>
<section id="about"><div class="wrap about"><div class="about-card"><img src="assets/mark.png" alt="Фірмовий знак Merry land"><div class="year"><b>2013</b> рік заснування</div></div><div><div class="kicker">Знайомимось ближче</div><h2 class="section-title">Merry land — твоя школа розвитку</h2><p>Ми пропонуємо якісні заняття з англійської мови для всіх вікових категорій у зручних форматах: <b>офлайн</b> або <b>онлайн</b> з будь-якої точки світу.</p><p>Наш головний акцент — розвиток розмовних навичок, щоб ви впевнено спілкувалися англійською в різних ситуаціях, а також ваш емоційний комфорт.</p><p>Наші програми поєднують методи педагогіки, музики та психології, пробуджуючи внутрішнє бажання навчатися, долати нові етапи й досягати омріяних рівнів мови.</p></div></div></section>
<section class="tinted" id="courses"><div class="wrap"><div class="section-top"><div class="kicker">Навчання з любов'ю</div><h2 class="section-title">Наші напрямки</h2><p class="lead">Оберіть програму, яка підходить саме вам. Натисніть «Вільні місця», щоб переглянути актуальні групи.</p></div><div class="cards" id="courses-list"><p>Завантаження напрямків…</p></div></div></section>
<section id="gallery"><div class="wrap"><div class="section-top"><div class="kicker">Наші моменти</div><h2 class="section-title">Життя Merry land</h2><p class="lead">Тут з'являться світлини занять, подій і наших маленьких та великих перемог.</p></div><div class="gallery" id="gallery-list"></div></div></section>
<section class="tinted" id="places"><div class="wrap"><div class="section-top"><div class="kicker">Приєднуйтесь до нас</div><h2 class="section-title">Вільні місця у групах</h2><p class="lead">Оберіть напрямок, вік і зручний час занять. Розклад можна оновлювати в панелі редагування.</p></div><div class="schedule-grid" id="schedule-list"></div></div></section>
<div id="custom-blocks"></div><section id="signup"><div class="wrap"><div class="signup"><div class="kicker">Почніть свою історію</div><h2 class="section-title">Записатись на заняття</h2><p>Для запису в групу заповніть коротку анкету. Ми зв'яжемося з вами для уточнення деталей.</p><a class="btn" href="https://forms.gle/1z4tKa7ogUzTSSNW6" target="_blank" rel="noopener noreferrer">Заповнити анкету ↗</a></div></div></section></main>
<footer class="footer"><div class="wrap footer-inner"><div>© <span id="year"></span> Merry land · Школа твого розвитку · Чернігів</div><div>Англійська офлайн та онлайн</div></div></footer><style>
#admin-open{position:fixed;right:18px;bottom:18px;z-index:35;border:0;background:#273a50;color:white;padding:12px 18px;border-radius:30px;font-weight:700}
