#admin-inner label{display:block;font-size:13px;font-weight:700}#admin-inner textarea{min-height:85px}
#admin-inner button{border:0;border-radius:10px;padding:10px 14px;margin:5px;background:#e5f4fd;font-weight:700;cursor:pointer}
#admin-inner .primary{background:#9cddff}#admin-inner .danger{background:#ffe1e1}
.editor-card{border:1px solid #d6e9f3;border-radius:16px;padding:16px;margin:14px 0;background:#fbfdff}
#admin-message{white-space:pre-wrap;color:#a33525;font-size:13px}#admin-inner small{line-height:1.5;display:block}
.custom-text{white-space:pre-line}.custom-img{width:100%;max-height:470px;object-fit:cover;border-radius:24px}
</style>
<button id="admin-open" type="button">⚙ Адмінпанель</button>
<div id="admin-panel"><aside id="admin-inner" role="dialog" aria-modal="true" aria-label="Адмінпанель">
<div style="display:flex;justify-content:space-between;align-items:center"><h2>Керування Merry land</h2><button id="admin-close">✕</button></div>
<p id="admin-message" role="status"></p>
<div id="login-view"><p>Увійдіть за допомогою облікового запису адміністратора Supabase.</p>
<label>Email<input id="login-email" type="email" autocomplete="username"></label>
<label>Пароль<input id="login-password" type="password" autocomplete="current-password"></label>
<button class="primary" id="login-button">Увійти</button></div>
<div id="editor-view" hidden><p id="admin-user"></p><button id="logout-button">Вийти</button>
<p><small>Зміни зберігаються в Supabase і після оновлення сторінки доступні всім відвідувачам. Для блоків можна обирати тип, змінювати тексти, URL фотографій, порядок та видимість.</small></p>
<button class="primary" id="add-block">+ Додати блок</button><div id="blocks-editor"></div></div>
</aside></div>
<script>
(()=>{'use strict';
const URL_BASE='https://dnwidwbgjhwtqeoeudel.supabase.co';
const KEY='sb_publishable_bq3Fr2NHkDmhof4HiuBigw_M7Rqi7K5';
const $=id=>document.getElementById(id);
const escapeHTML=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
let blocks=[],session=null;
function msg(s){$('admin-message').textContent=s||''}
function apiHeaders(auth=false){const h={'apikey':KEY,'Content-Type':'application/json'};if(auth&&session?.access_token)h.Authorization='Bearer '+session.access_token;return h}
async function request(path,options={},auth=false){const r=await fetch(URL_BASE+path,{...options,headers:{...apiHeaders(auth),...(options.headers||{})}});const t=await r.text();let data;try{data=t?JSON.parse(t):null}catch{data=t}if(!r.ok)throw Error((data&& (data.message||data.error_description||data.error))||'HTTP '+r.status);return data}
function setText(el,v){if(el&&v!==null&&v!==undefined)el.textContent=v}
function draw(){const hero=blocks.find(b=>b.page==='home'&&b.block_type==='hero'&&b.is_visible!==false);if(hero){setText(document.querySelector('.hero h1'),hero.title);setText(document.querySelector('.hero h2'),hero.subtitle);setText(document.querySelector('.hero p'),hero.description);if(hero.image_url)document.querySelector('.hero-art img').src=hero.image_url;const btn=document.querySelector('.hero .btn');if(hero.button_text)setText(btn,hero.button_text);if(hero.button_link)btn.href=hero.button_link}
const root=$('custom-blocks');root.replaceChildren();for(const b of blocks.filter(x=>x.page==='home'&&x.block_type!=='hero'&&x.is_visible!==false)){
const section=document.createElement('section');if(b.content?.background==='blue')section.className='tinted';const wrap=document.createElement('div');wrap.className='wrap';const title=document.createElement('h2');title.className='section-title';title.textContent=b.title||'';wrap.append(title);if(b.subtitle){const sub=document.createElement('p');sub.className='lead';sub.textContent=b.subtitle;wrap.append(sub)}if(b.description){const p=document.createElement('p');p.className='lead custom-text';p.textContent=b.description;wrap.append(p)}if(b.image_url){const img=document.createElement('img');img.className='custom-img';img.src=b.image_url;img.alt=b.title||'Фото Merry land';img.loading='lazy';wrap.append(img)}if(b.button_text&&b.button_link){const a=document.createElement('a');a.className='btn';a.href=b.button_link;a.textContent=b.button_text;wrap.append(a)}section.append(wrap);root.append(section)} }
async function loadBlocks(){try{blocks=await request('/rest/v1/page_blocks?select=*&page=eq.home&order=sort_order.asc,id.asc');draw()}catch(e){console.error('Помилка завантаження блоків',e)}}
async function loadCourses(){try{const courses=await request('/rest/v1/courses?select=*&order=id.asc');$('courses-list').innerHTML=courses.length?courses.map(c=>`<article class="course"><div class="course-media">${c.image_url?`<img src="${escapeHTML(c.image_url)}" alt="${escapeHTML(c.title)}">`:'✦'}</div><div class="course-body"><h3>${escapeHTML(c.title)}</h3><p>${escapeHTML(c.description)}</p><div class="price">${escapeHTML(c.price)}</div><a class="btn alt small" href="#places">Вільні місця ↗</a></div></article>`).join(''):'<p>Напрямки навчання незабаром з’являться.</p>'}catch(e){$('courses-list').innerHTML='<p>Напрямки поки недоступні.</p>';console.error(e)}}
function input(label,value,callback,multiline=false){const lab=document.createElement('label');lab.textContent=label;const el=document.createElement(multiline?'textarea':'input');el.value=value??'';el.onchange=()=>callback(el.value);lab.append(el);return lab}
function selectField(label,values,current,cb){const lab=document.createElement('label');lab.textContent=label;const sel=document.createElement('select');for(const [val,text] of values){const opt=document.createElement('option');opt.value=val;opt.textContent=text;sel.append(opt)}sel.value=current;sel.onchange=()=>cb(sel.value);lab.append(sel);return lab}
function editor(){const root=$('blocks-editor');root.replaceChildren();for(const original of blocks){const b={...original};const card=document.createElement('div');card.className='editor-card';const heading=document.createElement('h3');heading.textContent=`Блок #${b.id}: ${b.title||b.block_type}`;card.append(heading);
card.append(selectField('Тип блоку',[['hero','Головний екран'],['text','Текстовий блок'],['image','Блок із фото'],['cta','Заклик до дії']],b.block_type,v=>b.block_type=v));
for(const [label,key,multi] of [['Заголовок','title',false],['Підзаголовок','subtitle',false],['Опис','description',true],['URL фотографії','image_url',false],['Текст кнопки','button_text',false],['Посилання кнопки','button_link',false],['Порядок (число)','sort_order',false]])card.append(input(label,b[key],v=>b[key]=key==='sort_order'?Number(v)||0:v,multi));
card.append(selectField('Видимість',[['true','Показувати'],['false','Приховати']],String(b.is_visible!==false),v=>b.is_visible=v==='true'));
const save=document.createElement('button');save.className='primary';save.textContent='Зберегти блок';save.onclick=async()=>{try{msg('Зберігаємо…');await request('/rest/v1/page_blocks?id=eq.'+encodeURIComponent(b.id),{method:'PATCH',headers:{Prefer:'return=minimal'},body:JSON.stringify({block_type:b.block_type,title:b.title,subtitle:b.subtitle,description:b.description,image_url:b.image_url,button_text:b.button_text,button_link:b.button_link,sort_order:b.sort_order,is_visible:b.is_visible})},true);msg('Блок збережено');await loadBlocks();editor()}catch(e){msg('Не вдалося зберегти: '+e.message)}};
const del=document.createElement('button');del.className='danger';del.textContent='Видалити';del.onclick=async()=>{if(!confirm('Назавжди видалити цей блок?'))return;try{await request('/rest/v1/page_blocks?id=eq.'+encodeURIComponent(b.id),{method:'DELETE'},true);msg('Блок видалено');await loadBlocks();editor()}catch(e){msg('Помилка видалення: '+e.message)}};card.append(save,del);root.append(card)}}
function showAuth(){const yes=!!session?.access_token;$('login-view').hidden=yes;$('editor-view').hidden=!yes;if(yes){$('admin-user').textContent='Вхід: '+(session.user?.email||'адміністратор');editor()}}
async function signIn(){try{msg('Перевіряємо дані…');const data=await request('/auth/v1/token?grant_type=password',{method:'POST',body:JSON.stringify({email:$('login-email').value.trim(),password:$('login-password').value})});session=data;sessionStorage.setItem('ml-session',JSON.stringify(data));$('login-password').value='';msg('Вхід успішний');showAuth()}catch(e){msg('Не вдалося увійти: '+e.message)}}
$('login-button').onclick=signIn;$('logout-button').onclick=async()=>{try{await request('/auth/v1/logout',{method:'POST'},true)}catch{}session=null;sessionStorage.removeItem('ml-session');msg('Ви вийшли');showAuth()};
$('add-block').onclick=async()=>{try{const count=blocks.length;await request('/rest/v1/page_blocks',{method:'POST',headers:{Prefer:'return=minimal'},body:JSON.stringify({page:'home',block_type:'text',title:'Новий блок',subtitle:'',description:'Додайте текст',sort_order:count+1,is_visible:true})},true);msg('Новий блок створено');await loadBlocks();editor()}catch(e){msg('Не вдалося створити блок: '+e.message)}};
$('admin-open').onclick=()=>{$('admin-panel').classList.add('open');showAuth()};$('admin-close').onclick=()=>$('admin-panel').classList.remove('open');$('admin-panel').onclick=e=>{if(e.target===$('admin-panel'))$('admin-panel').classList.remove('open')};
$('mobile-menu').onclick=()=>$('links').classList.toggle('show');document.querySelectorAll('.links a').forEach(a=>a.onclick=()=>$('links').classList.remove('show'));$('year').textContent=new Date().getFullYear();
try{session=JSON.parse(sessionStorage.getItem('ml-session')||'null')}catch{};loadBlocks();loadCourses();showAuth();
})();
</script></body></html>
